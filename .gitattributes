# Normalise text to LF in the repo and working tree
* text=auto eol=lf

# Binary assets: never touch line endings or diff as text
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary

# SVG is text, but keep it LF
*.svg    text eol=lf
